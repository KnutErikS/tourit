{
  "name": "tourit",
  "private": true,
  "version": "0.1.0",
  "description": "Avalanche terrain map for Norway: Varsom warnings, NVE steepness, aspect from Kartverket DTM and Regobs observations.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "crags": "node scripts/crags.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.2.0",
    "@fontsource/barlow-condensed": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "leaflet": "^1.9.4",
    "lerc": "4.3.0",
    "maplibre-gl": "^6.0.0",
    "mgrs": "^2.1.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
